# Production environment of docker-compose.prod.yml. Copy to .env.production
# on the server and fill in; never commit the copy. Passwords:
# openssl rand -base64 32

# The domain nginx serves and certbot issues the certificate for. Its DNS A
# record must point at this server before the first certificate is issued.
API_DOMAIN=way-pay.org

# Postgres superuser: owns the schema, used only by the migration step
# (../nest/.env.production.migrate).
POSTGRES_USER=split_trip_owner
POSTGRES_PASSWORD=
POSTGRES_DATABASE=split_trip_nest

# The API's and the worker's own role (../nest/.env.production DATABASE_URL):
# reads and writes the tables, nothing more. Created when the data volume is
# first initialised — changing it later needs ALTER ROLE by hand.
APP_DB_USER=split_trip_app
APP_DB_PASSWORD=

# Redis. The Nest app's REDIS_PASSWORD is the same value.
REDIS_PASSWORD=
